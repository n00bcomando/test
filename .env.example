# Database
MONGODB_URI=mongodb://localhost:27017/roblox_rewards

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_here

# Server Configuration
PORT=5000
NODE_ENV=development

# Roblox API
ROBLOX_API_KEY=your_roblox_api_key
ROBLOX_UNIVERSE_ID=your_universe_id

# Ad Network APIs
ADGATE_API_KEY=your_adgate_api_key
OFFERTORO_API_KEY=your_offertoro_api_key
CPXRESEARCH_API_KEY=your_cpxresearch_api_key

# Payment APIs
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# Admin Configuration
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100